<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared UI: App, AppShell, every view, the dialogs and the stores. Desktop and Android
    each add only a thin head on top of this, so there is one copy of the app.

    Deliberately does NOT reference Avalonia.Desktop, which would drag the desktop windowing
    backends into the APK. Each head brings its own platform package.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChivRcon.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChivRcon.Core\ChivRcon.Core.csproj" />
  </ItemGroup>

</Project>
