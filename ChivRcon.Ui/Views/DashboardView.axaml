<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:ChivRcon.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ChivRcon.App.Views.DashboardView">

    <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0" Classes="sectionTitle" Text="Dashboard" />
        <TextBlock Grid.Row="1" Classes="hint" Margin="0,4,0,16"
                   x:Name="RosterHint" />

        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
            <!-- 930px of columns will not fit a phone; header and rows scroll as one. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="930" RowDefinitions="Auto,Auto,*">

                    <TextBlock Grid.Row="0" x:Name="RosterHeader" Classes="cardHeader"
                               Text="PLAYERS" Margin="16,14,16,12" />

                    <!--
                        Column widths are repeated in the item template below rather than shared
                        through a resource: Grid.ColumnDefinitions takes a string, and threading
                        one through StaticResource is more fragile than keeping two literals next
                        to each other. Change both together.
                    -->
                    <Border Grid.Row="1" Classes="headerStrip">
                        <Grid ColumnDefinitions="180,70,50,125,140,55,50,50,55,45,70,*">
                            <TextBlock Grid.Column="0" Classes="colHeader" Text="Name" />
                            <TextBlock Grid.Column="1" Classes="colHeader" Text="Team" />
                            <TextBlock Grid.Column="2" Classes="colHeader" Text="Ping" />
                            <TextBlock Grid.Column="3" Classes="colHeader" Text="Identity" />
                            <TextBlock Grid.Column="4" Classes="colHeader" Text="SteamID64" />
                            <TextBlock Grid.Column="5" Classes="colHeader" Text="Score" />
                            <TextBlock Grid.Column="6" Classes="colHeader" Text="Kills" />
                            <TextBlock Grid.Column="7" Classes="colHeader" Text="Rank" />
                            <TextBlock Grid.Column="8" Classes="colHeader" Text="Idle" />
                            <TextBlock Grid.Column="9" Classes="colHeader" Text="TD" />
                            <TextBlock Grid.Column="10" Classes="colHeader" Text="Notes" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" x:Name="Players" Classes="rows" Margin="0,4,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:Player">
                                <Grid ColumnDefinitions="180,70,50,125,140,55,50,50,55,45,70,*">
                                    <TextBlock Grid.Column="0" Classes="cell" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="cellDim" Text="{Binding TeamName}" />
                                    <TextBlock Grid.Column="2" Classes="cellDim" Text="{Binding Ping}" />
                                    <TextBlock Grid.Column="3" Classes="cellDim" Text="{Binding IdentityText}" />
                                    <TextBlock Grid.Column="4" Classes="cellDim" Text="{Binding SteamId64}" />
                                    <TextBlock Grid.Column="5" Classes="cell" Text="{Binding Score}" />
                                    <TextBlock Grid.Column="6" Classes="cell" Text="{Binding Kills}" />
                                    <TextBlock Grid.Column="7" Classes="cellDim" Text="{Binding Rank}" />
                                    <TextBlock Grid.Column="8" Classes="cellDim" Text="{Binding IdleText}" />
                                    <TextBlock Grid.Column="9" Classes="cellDim" Text="{Binding TeamDamage}" />
                                    <TextBlock Grid.Column="10" Classes="cell" Text="{Binding NoteBadge}"
                                               Foreground="{StaticResource Warning}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
