<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ChivRcon.App.Views.TournamentView">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,26">

            <TextBlock Classes="sectionTitle" Text="Tournament" />
            <TextBlock Classes="hint" Margin="0,4,0,16"
                       Text="Running a match: hold the round until both teams are ready, then referee it." />

            <!-- ============ READY GATE ============ -->
            <Border Classes="card" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Classes="cardHeader" Text="READY GATE" Margin="16,14,16,0" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,12,0,0" />

                    <WrapPanel ItemSpacing="10" LineSpacing="10" Margin="16,14,16,0">
                        <Button x:Name="TournOnBtn" Classes="primary" Height="34" MinWidth="150"
                                Content="Tournament ON" Click="TournOn_Click" />
                        <Button x:Name="TournOffBtn" Classes="ghost" Height="34" MinWidth="140"
                                Content="Tournament OFF" Click="TournOff_Click" />
                        <TextBlock Classes="label" Text="Ready threshold" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                        <NumericUpDown x:Name="ThresholdBox" Minimum="1" Maximum="100" Value="100"
                                       Increment="5" FormatString="0" Width="110" />
                        <TextBlock Classes="hint" Text="% per team" VerticalAlignment="Center" />
                    </WrapPanel>

                    <TextBlock Classes="hint" Margin="16,10,16,0" TextWrapping="Wrap"
                               Text="Tournament mode holds the pre-round until each team reaches the threshold, and disables autobalance, the ping limit and the team-damage penalty — matching what the ?Tournament launch option does." />
                    <TextBlock Classes="hint" Margin="16,6,16,14" TextWrapping="Wrap"
                               Foreground="{StaticResource Warning}"
                               Text="It is one-shot: the game clears it the moment a round starts (AOCGame.StartRound), so switch it back on before each round. Turning it off does not restore autobalance or the ping limit — the server cannot know what they were, so set those yourself if you need them back." />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                    <WrapPanel ItemSpacing="10" LineSpacing="10" Margin="16,14,16,14">
                        <Button x:Name="ReadyAllBtn" Classes="primary" Height="34" MinWidth="150"
                                Content="Force all ready" Click="ReadyAll_Click" />
                        <Button x:Name="UnreadyAllBtn" Classes="ghost" Height="34" MinWidth="150"
                                Content="Clear all ready" Click="UnreadyAll_Click" />
                        <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Clear also drops the admin ready override, which is what a re-match needs." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============ MATCH CONTROL ============ -->
            <Border Classes="card" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Classes="cardHeader" Text="MATCH CONTROL" Margin="16,14,16,0" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,12,0,0" />

                    <WrapPanel ItemSpacing="10" LineSpacing="10" Margin="16,14,16,0">
                        <Button x:Name="PauseBtn" Classes="primary" Height="34" MinWidth="120"
                                Content="Pause" Click="Pause_Click" />
                        <Button x:Name="UnpauseBtn" Classes="ghost" Height="34" MinWidth="120"
                                Content="Unpause" Click="Unpause_Click" />
                        <Button x:Name="RestartBtn" Classes="ghost" Height="34" MinWidth="140"
                                Content="Restart match" Click="Restart_Click" />
                        <Button x:Name="EndMatchBtn" Classes="danger" Height="34" MinWidth="130"
                                Content="End match…" Click="EndMatch_Click" />
                    </WrapPanel>

                    <TextBlock Classes="hint" Margin="16,10,16,14" TextWrapping="Wrap"
                               Text="Unpause runs XangMod's 3-2-1-GO countdown so nobody is caught cold. Restart returns to the pre-round, which is where the ready gate applies." />
                </StackPanel>
            </Border>

            <!-- ============ SCORE ============ -->
            <Border Classes="card" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Classes="cardHeader" Text="SCORE" Margin="16,14,16,0" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,12,0,0" />

                    <WrapPanel ItemSpacing="10" LineSpacing="10" Margin="16,14,16,14">
                        <!-- Labels are set from GameProfile: team 0 and team 1 are Agatha and
                             Mason in Medieval Warfare, Blue and Red in Deadliest Warrior. -->
                        <TextBlock x:Name="Team0Label" Classes="label" Text="Agatha" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="Team0Score" Minimum="0" Maximum="9999" Value="0"
                                       Increment="1" FormatString="0" Width="110" />
                        <TextBlock x:Name="Team1Label" Classes="label" Text="Mason" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <NumericUpDown x:Name="Team1Score" Minimum="0" Maximum="9999" Value="0"
                                       Increment="1" FormatString="0" Width="110" />
                        <Button x:Name="ApplyScoreBtn" Classes="primary" Height="34" MinWidth="130"
                                Margin="10,0,0,0" Content="Apply scores" Click="ApplyScore_Click" />
                    </WrapPanel>

                    <TextBlock Classes="hint" Margin="16,10,16,14" TextWrapping="Wrap"
                               Text="On LTS this sets rounds won, which is the value the match-end check reads. That check is an exact match against the goal taken after the winning round is added, so a team parked on the goal steps over it and the match never ends — set one below the goal if the next round should decide it." />
                </StackPanel>
            </Border>

            <!-- ============ SPEED ============ -->
            <Border Classes="card" Padding="0">
                <StackPanel>
                    <TextBlock Classes="cardHeader" Text="GAME SPEED" Margin="16,14,16,0" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,12,0,0" />

                    <WrapPanel ItemSpacing="10" LineSpacing="10" Margin="16,14,16,0">
                        <Button x:Name="SpeedQuarterBtn" Classes="ghost" Height="34" MinWidth="72"
                                Content="0.25x" Click="SpeedQuarter_Click" />
                        <Button x:Name="SpeedHalfBtn" Classes="ghost" Height="34" MinWidth="72"
                                Content="0.5x" Click="SpeedHalf_Click" />
                        <Button x:Name="SpeedNormalBtn" Classes="primary" Height="34" MinWidth="96"
                                Content="Normal" Click="SpeedNormal_Click" />
                        <Button x:Name="SpeedOneAndHalfBtn" Classes="ghost" Height="34" MinWidth="72"
                                Content="1.5x" Click="SpeedOneAndHalf_Click" />
                        <Button x:Name="SpeedDoubleBtn" Classes="ghost" Height="34" MinWidth="72"
                                Content="2x" Click="SpeedDouble_Click" />
                    </WrapPanel>

                    <TextBlock Classes="hint" Margin="16,10,16,14" TextWrapping="Wrap"
                               Text="Uses the dedicated speed opcode rather than a console command, because AOCGame.SetGameSpeed has to notify clients and republish the speed — a bare console command does not." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
