<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:ChivRcon.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ChivRcon.App.Views.ReferenceView">

    <Grid Margin="26,22,26,26" RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0" Classes="sectionTitle" Text="Reference" />
        <TextBlock Grid.Row="1" Classes="hint" Margin="0,4,0,14"
                   Text="What this client can ask a server to do, and which server builds understand it. A server ignores commands it does not know, so a XangMod-only entry simply does nothing against a stock one." />

        <WrapPanel ItemSpacing="10" LineSpacing="10" Grid.Row="2" Margin="0,0,0,14">
            <TextBox x:Name="Filter" Width="300" PlaceholderText="Filter by name, place or text…"
                     KeyUp="Filter_KeyUp" />
            <Button x:Name="ClearFilterBtn" Classes="mini" MinWidth="72"
                    Content="Clear" Click="ClearFilter_Click" />
            <TextBlock x:Name="CountText" Classes="hint" VerticalAlignment="Center" Text="" />
        </WrapPanel>

        <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
            <!-- 540px of columns will not fit a phone; header and rows scroll as one. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="540" RowDefinitions="Auto,*">

                    <!-- Column widths repeated in the item template below. Change both together. -->
                    <Border Grid.Row="0" Classes="headerStrip">
                        <Grid ColumnDefinitions="230,170,100,*">
                            <TextBlock Grid.Column="0" Classes="colHeader" Text="Command" />
                            <TextBlock Grid.Column="1" Classes="colHeader" Text="Where" />
                            <TextBlock Grid.Column="2" Classes="colHeader" Text="Needs" />
                            <TextBlock Grid.Column="3" Classes="colHeader" Text="What it does" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Entries" Margin="0,6,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="app:CommandRef">
                                    <Grid ColumnDefinitions="230,170,100,*" Margin="16,5,16,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="Medium" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Where}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Needs}"
                                                   Foreground="{StaticResource TextFaint}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
