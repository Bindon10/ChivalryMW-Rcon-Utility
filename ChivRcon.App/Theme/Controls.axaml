<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- Primary action button                                  -->
    <!-- ===================================================== -->
    <Style Selector="Button.primary">
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="Padding" Value="34,0" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHover}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentPressed}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>

    <!-- Play / Repair variants of the same button -->
    <Style Selector="Button.primary.play">
        <Setter Property="Background" Value="{StaticResource Success}" />
    </Style>
    <Style Selector="Button.primary.repair">
        <Setter Property="Background" Value="{StaticResource Warning}" />
    </Style>

    <!-- ===================================================== -->
    <!-- Secondary / ghost button                               -->
    <!-- ===================================================== -->
    <Style Selector="Button.ghost">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BgPanelHi}" />
    </Style>

    <Style Selector="Button.mini">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{StaticResource BgPanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.mini:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Window chrome buttons -->
    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#C4384A" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ===================================================== -->
    <!-- Sidebar navigation                                     -->
    <!-- ===================================================== -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ===================================================== -->
    <!-- Cards and typography                                   -->
    <!-- ===================================================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource BgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="16,15" />
    </Style>

    <Style Selector="TextBlock.cardHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ===================================================== -->
    <!-- Inputs                                                 -->
    <!-- ===================================================== -->
    <Style Selector="TextBox.path">
        <Setter Property="Background" Value="#171A20" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
    </Style>
    <Style Selector="TextBox.path:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ProgressBar.patch">
        <Setter Property="Height" Value="5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource BgPanelAlt}" />
    </Style>


    <!-- ===================================================== -->
    <!-- ChivRcon additions                                     -->
    <!--                                                        -->
    <!-- Everything above this line is Supremacy Launcher's      -->
    <!-- Theme/Controls.axaml verbatim. Keep it that way: the    -->
    <!-- two apps are meant to look like siblings, so shared     -->
    <!-- styles get fixed there and copied here, not forked.     -->
    <!-- Below are the controls the launcher has no use for.     -->
    <!-- ===================================================== -->

    <!-- Destructive action. The launcher has no equivalent; it never asks to break anything. -->
    <Style Selector="Button.danger">
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#DE6060" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>

    <!-- Ordinary inputs. The launcher only ever styles TextBox.path. -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#171A20" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- AutoCompleteBox hosts a TextBox in its template, so it needs the same treatment. -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ TextBox">
        <Setter Property="Background" Value="#171A20" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="9,6" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#171A20" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="#171A20" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- ===================================================== -->
    <!-- Data rows (roster, ban list)                           -->
    <!--                                                        -->
    <!-- A ListBox rather than a DataGrid: DataGrid needs its    -->
    <!-- own package and theme include, and every column here    -->
    <!-- is fixed-width text, so the extra dependency would buy  -->
    <!-- nothing. Header and rows share one column definition    -->
    <!-- string so they cannot drift.                           -->
    <!-- ===================================================== -->
    <Style Selector="ListBox.rows">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="6,0,6,1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:nth-child(2n) /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E212800" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelAlt}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Column header strip above a ListBox.rows -->
    <Style Selector="TextBlock.colHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.headerStrip">
        <Setter Property="Background" Value="{StaticResource BgPanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style Selector="TextBlock.cell">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cellDim">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- ===================================================== -->
    <!-- Event feed                                             -->
    <!-- ===================================================== -->
    <Style Selector="TextBlock.logLine">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.feed">
        <Setter Property="Background" Value="#171A20" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ===================================================== -->
    <!-- Sidebar footer / status                                -->
    <!-- ===================================================== -->
    <Style Selector="TextBlock.statusLine">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="CheckBox.compact">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

</Styles>
