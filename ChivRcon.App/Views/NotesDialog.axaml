<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChivRcon.App.Views.NotesDialog"
        Title="Player notes"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgWindow}">

    <Border Padding="24,22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel Spacing="14">

            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="SubText" Classes="hint" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="label" Text="Warnings" VerticalAlignment="Center" />
                <NumericUpDown x:Name="WarnBox" Minimum="0" Maximum="99" Increment="1"
                               FormatString="0" Width="110" />
                <CheckBox x:Name="WatchBox" Classes="compact" Content="Watchlist"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="label" Text="Note" Margin="0,0,0,6" />
                <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="120" VerticalContentAlignment="Top"
                         PlaceholderText="What happened, and when. Whoever reads this next will not have been there." />
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="label" Text="Known names" Margin="0,0,0,4" />
                <TextBlock x:Name="NamesText" Classes="hint" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="CancelBtn" Classes="ghost" Height="34" Content="Cancel"
                        Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="SaveBtn" Classes="primary" Height="34" MinWidth="110"
                        Padding="18,0" FontSize="13" Content="Save"
                        Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
