<!--
    SystemDecorations is deprecated in Avalonia 12 in favour of WindowDecorations, and this
    raises AVLN5001. Left alone deliberately: the deprecation message names the replacement
    property but not how its values map, the old property still works, and Supremacy Launcher
    is on the same call. Change it only against the real WindowDecorations enum, not a guess.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ChivRcon.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="800"
        x:Class="ChivRcon.App.Views.MainWindow"
        Title="Chivalry RCON Utility"
        Width="1240" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        SystemDecorations="BorderOnly">

    <Grid RowDefinitions="36,*">

        <!-- ============ TITLE BAR ============ -->
        <Grid Grid.Row="0"
              Background="{StaticResource BgPanel}"
              ColumnDefinitions="Auto,Auto,*,Auto"
              PointerPressed="TitleBar_PointerPressed"
              DoubleTapped="TitleBar_DoubleTapped">

            <TextBlock Grid.Column="0" Text="Chivalry RCON" VerticalAlignment="Center"
                       Margin="14,0,0,0" FontWeight="SemiBold" FontSize="13"
                       Foreground="{StaticResource TextPrimary}" />

            <TextBlock Grid.Column="1" Text="BangMod / XangMod / AdminMod" VerticalAlignment="Center"
                       Margin="8,0,0,0" FontSize="11.5"
                       Foreground="{StaticResource TextFaint}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,4,0">
                <Button Classes="chrome" Content="&#x2013;" Click="Minimize_Click" />
                <Button Classes="chrome" Content="&#x25A1;" Click="Maximize_Click" />
                <Button Classes="chrome close" Content="&#x2715;" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ============ BODY ============ -->
        <views:AppShell Grid.Row="1" x:Name="Shell" />
    </Grid>
</Window>
