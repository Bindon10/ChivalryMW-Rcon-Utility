<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChivRcon.Android</RootNamespace>
    <AssemblyName>ChivRconUtility.Android</AssemblyName>
    <ApplicationId>ca.bindon.chivrcon</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Phones are arm64. Add android-x86_64 back if you want to run it in an emulator. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>

    <!--
      Debug builds default this to false: fast deployment leaves the managed assemblies OUT of
      the APK and expects adb to push them separately. A Debug APK copied to a phone by hand
      therefore has no managed code and dies on launch. Sideloading is the normal test loop
      here, so every APK carries its own assemblies.
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="Android.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChivRcon.Core\ChivRcon.Core.csproj" />
    <ProjectReference Include="..\ChivRcon.Ui\ChivRcon.Ui.csproj" />
  </ItemGroup>

</Project>
